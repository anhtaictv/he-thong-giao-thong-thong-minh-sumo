<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- Bản DEMO cho GUI/quay video: vẫn 36 xe nhưng dồn vào ~4 phút để hình ảnh đông xe hơn. -->
    <vType id="sedan" vClass="passenger" guiShape="passenger/sedan" imgFile="cars/sedan.png" length="4.8" width="1.8" accel="2.6" decel="4.5" maxSpeed="13.9" color="40,120,220"/>
    <vType id="suv" vClass="passenger" guiShape="passenger/van" imgFile="cars/suv.png" length="5.0" width="1.9" accel="2.3" decel="4.5" maxSpeed="13.9" color="220,50,50"/>
    <vType id="taxi" vClass="taxi" guiShape="taxi" imgFile="cars/taxi.png" length="4.8" width="1.8" accel="2.6" decel="4.5" maxSpeed="13.9" color="240,190,20"/>
    <vType id="truck" vClass="truck" guiShape="truck" imgFile="cars/truck.png" length="7.0" width="2.4" accel="1.3" decel="4.0" maxSpeed="11.1" color="80,80,80"/>
    <vType id="bus" vClass="bus" guiShape="bus" imgFile="cars/bus.png" length="10" width="2.5" accel="1.2" decel="4.0" maxSpeed="11.1" color="50,180,50"/>
    <vType id="motorbike" vClass="motorcycle" guiShape="motorcycle" imgFile="cars/motorcycle.png" accel="3.5" decel="5" length="2.2" width="0.9" minGap="1.5" maxSpeed="16.7" sigma="0.6" color="230,60,30"/>
    <!-- Xe cứu thương: KHÔNG nằm trong luồng ngẫu nhiên, chỉ được thêm bằng TraCI ở kịch bản emergency -->
    <vType id="ambulance" vClass="emergency" guiShape="emergency" length="6.5" width="2.2" accel="3.0" decel="5.0" maxSpeed="16.7" color="255,255,255"/>
    <vTypeDistribution id="allTypes" vTypes="sedan suv taxi truck bus motorbike"/>

    <!-- 12 luồng = mọi cặp (hướng vào -> hướng ra), đi thẳng / rẽ trái / rẽ phải.
         LƯU Ý: period="exp(X)" trong SUMO nghĩa là X xe/GIÂY (phân phối Poisson),
         KHÔNG phải "1 xe mỗi X giây". exp(0.015) = trung bình 1 xe / ~67s mỗi luồng; number="3" -> tổng luôn = 36 xe. -->
    <flow id="N_S" type="allTypes" from="N_in" to="S_out" begin="0" number="3" period="exp(0.015)"/>
    <flow id="N_E" type="allTypes" from="N_in" to="E_out" begin="0" number="3" period="exp(0.015)"/>
    <flow id="N_W" type="allTypes" from="N_in" to="W_out" begin="0" number="3" period="exp(0.015)"/>
    <flow id="S_N" type="allTypes" from="S_in" to="N_out" begin="0" number="3" period="exp(0.015)"/>
    <flow id="S_E" type="allTypes" from="S_in" to="E_out" begin="0" number="3" period="exp(0.015)"/>
    <flow id="S_W" type="allTypes" from="S_in" to="W_out" begin="0" number="3" period="exp(0.015)"/>
    <flow id="E_W" type="allTypes" from="E_in" to="W_out" begin="0" number="3" period="exp(0.015)"/>
    <flow id="E_N" type="allTypes" from="E_in" to="N_out" begin="0" number="3" period="exp(0.015)"/>
    <flow id="E_S" type="allTypes" from="E_in" to="S_out" begin="0" number="3" period="exp(0.015)"/>
    <flow id="W_E" type="allTypes" from="W_in" to="E_out" begin="0" number="3" period="exp(0.015)"/>
    <flow id="W_N" type="allTypes" from="W_in" to="N_out" begin="0" number="3" period="exp(0.015)"/>
    <flow id="W_S" type="allTypes" from="W_in" to="S_out" begin="0" number="3" period="exp(0.015)"/>
</routes>
