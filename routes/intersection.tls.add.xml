<?xml version="1.0" encoding="UTF-8"?>
<additional>
    <!-- Chương trình đèn có thể chỉnh sửa của TL1 (yêu cầu #5).
         Sửa các giá trị "duration" để đổi thời gian từng pha / tổng chu kỳ.
         Mặc định: chu kỳ 94s = Xanh 42 + Vàng 3 + Đỏ toàn phần 2 (x2 hướng).

         Thứ tự 12 ký tự trong state (linkIndex):
           0-2  : Bắc  (N_in)  phải / thẳng / trái
           3-5  : Đông (E_in)  phải / thẳng / trái
           6-8  : Nam  (S_in)  phải / thẳng / trái
           9-11 : Tây  (W_in)  phải / thẳng / trái
         G = xanh ưu tiên, g = xanh phải nhường (rẽ trái), y = vàng, r = đỏ -->
    <tlLogic id="TL1" type="static" programID="1" offset="0">
        <phase duration="42" state="GGgrrrGGgrrr" name="NS_GREEN"/>
        <phase duration="3"  state="yyyrrryyyrrr" name="NS_YELLOW"/>
        <phase duration="2"  state="rrrrrrrrrrrr" name="ALL_RED_1"/>
        <phase duration="42" state="rrrGGgrrrGGg" name="EW_GREEN"/>
        <phase duration="3"  state="rrryyyrrryyy" name="EW_YELLOW"/>
        <phase duration="2"  state="rrrrrrrrrrrr" name="ALL_RED_2"/>
    </tlLogic>
</additional>
